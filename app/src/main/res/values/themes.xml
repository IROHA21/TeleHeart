<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ==================== -->
    <!-- Material3 Main Theme -->
    <!-- ==================== -->
    <style name="Base.Theme.Lasttele" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- RadioButton/CheckBox colors for Material3 components -->
        <item name="colorPrimary">@color/blue</item>          <!-- Checked state -->
        <item name="colorOnSurfaceVariant">@color/black</item> <!-- Unchecked state -->

        <!-- Your other Material3 customizations -->
    </style>

    <style name="Theme.Lasttele" parent="Base.Theme.Lasttele" />

    <!-- ======================== -->
    <!-- Legacy AppCompat Theme -->
    <!-- ======================== -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- RadioButton/CheckBox colors for legacy components -->
        <item name="colorControlActivated">@color/blue</item>
        <item name="colorControlNormal">@color/black</item>

        <!-- Your legacy theme customizations -->
    </style>

    <!-- ================= -->
    <!-- Dialog Theme -->
    <!-- ================= -->
    <style name="AppTheme.CustomTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>