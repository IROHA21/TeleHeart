<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Welcome Message -->

    <!-- Heart Image -->

    <TextView
        android:id="@+id/welcome_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Welcome_to_TeleHeart"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="120dp"
        android:elevation="10dp" />

    <ImageView
        android:id="@+id/heart_image"
        android:layout_width="320dp"
        android:layout_height="389dp"
        android:layout_below="@id/welcome_message"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:elevation="10dp"
        android:src="@drawable/heart" />

    <!-- Start Button -->

    <!-- Tutorial Button -->
    <!-- Language Selection Spinner -->

    <Spinner
        android:id="@+id/language_spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_spinner_background"
        android:popupBackground="@drawable/dropdown_background"
        android:spinnerMode="dropdown" />

    <Button
        android:id="@+id/start_button"
        android:layout_width="202dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/heart_image"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="105dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="104dp"
        android:backgroundTint="#0061ff"
        android:elevation="10dp"
        android:onClick="onStartClick"
        android:paddingHorizontal="40dp"
        android:paddingVertical="20dp"
        android:text="@string/Start"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/tutorial_button"
        android:layout_width="162dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/start_button"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:backgroundTint="#0061ff"
        android:elevation="10dp"
        android:paddingHorizontal="40dp"
        android:paddingVertical="20dp"
        android:text="@string/Tutorial"
        android:textColor="@android:color/white" />

    <!-- White Image 1 -->
    <ImageView
        android:id="@+id/white1"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/white"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="50dp"
        android:layout_marginStart="20dp" />

    <!-- Blue Image 1 -->
    <ImageView
        android:id="@+id/blue1"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/blue"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="100dp"
        android:layout_marginEnd="40dp" />

    <!-- White Image 2 -->
    <ImageView
        android:id="@+id/white2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/white"
        android:layout_centerInParent="true"
        android:layout_marginTop="200dp"
        android:layout_marginStart="150dp" />

    <!-- Blue Image 2 -->
    <ImageView
        android:id="@+id/blue2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/blue"
        android:layout_centerInParent="true"
        android:layout_marginTop="300dp"
        android:layout_marginStart="50dp" />

    <ImageButton
        android:id="@+id/imageButton3"
        android:layout_width="52dp"
        android:layout_height="49dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="31dp"
        android:layout_marginEnd="25dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:onClick="onsettingsclick"
        app:srcCompat="@drawable/menu" />


</RelativeLayout>