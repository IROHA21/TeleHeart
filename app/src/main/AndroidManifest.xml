<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.moon.TeleHeart">


    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/noborder"
        android:label="TeleHeart"
        android:roundIcon="@drawable/noborder"

        android:supportsRtl="true"
        android:theme="@style/Theme.Lasttele"
        android:forceDarkAllowed="false"

        tools:targetApi="31" >

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>



        <activity android:name=".loading.LoadingActivity"
            android:screenOrientation="portrait"
            />
        <activity android:name=".result.ResultsActivity"
            android:screenOrientation="portrait"/>
        <activity android:name=".login.rememberaccount"
            android:theme="@style/AppTheme.CustomTheme"/>
        <activity
            android:name=".contacts.ContactsActivity"
            android:exported="false"
            android:label="ContactsActivity"
            android:theme="@style/Theme.Lasttele"
            android:screenOrientation="portrait"



            />
        <activity android:name=".settings.SettingsActivity"
            />
        <activity
            android:name=".login.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">

        </activity>

        <activity
            android:name=".login.popactivity"
            android:theme="@style/AppTheme.CustomTheme"/>
        <activity
            android:name=".contacts.popnum"
            android:theme="@style/AppTheme.CustomTheme"/>
        <activity
            android:name=".firstscreen.popag"
            android:theme="@style/AppTheme.CustomTheme"/>
        <activity
            android:name=".result.popdisconnect"
            android:theme="@style/AppTheme.CustomTheme"/>

        <activity
            android:name=".firstscreen.Firstscreen"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <service android:name=".MyService" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>